# ─── Lint ───────────────────────────────────────────────────
lint:
    ruff check .
    shellcheck ../.githooks/commit-msg

# ─── Format ─────────────────────────────────────────────────
format:
    ruff format .
    shfmt -w ../.githooks/commit-msg .envrc

check-format:
    ruff format --check .
    shfmt -d ../.githooks/commit-msg .envrc

# ─── Test (unit + integration) ──────────────────────────────
test:
    python -m pytest tests/ -v --cov --cov-config=.coveragerc

# ─── Build (PDF + DOCX) ─────────────────────────────────────
build:
    ./src/build_pdf.py resources/cv.md
    ./src/build_docx.py resources/cv.md

# ─── Validate (lint + check format) ─────────────────────────
validate: lint check-format
