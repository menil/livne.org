# ─── Lint ───────────────────────────────────────────────────
lint:
    ruff check .
    shellcheck ../.githooks/commit-msg

# ─── Format ─────────────────────────────────────────────────
format:
    ruff format .
    shfmt -w ../.githooks/commit-msg .envrc

check-format:
    ruff format --check .
    shfmt -d ../.githooks/commit-msg .envrc

# ─── Test (unit + integration) ──────────────────────────────
test:
    python -m pytest tests/ -v --cov --cov-config=.coveragerc

# ─── Resume schema validation ────────────────────────────────
validate-resume:
    python -m src.validate_resume resources/cv.yaml

# ─── Export YAML (PII resolved) ──────────────────────────────
export-yaml: validate-resume
    mkdir -p dist
    python -m src.export_yaml resources/cv.yaml dist/cv.yaml

# ─── Build (PDF + DOCX) ─────────────────────────────────────
build: export-yaml
    mkdir -p dist
    ./src/md/render_md.py resources/cv.yaml dist/cv.md
    ./src/pdf/build_pdf.py resources/cv.yaml            # recruiter
    ./src/pdf/build_pdf.py resources/cv.yaml --public   # public
    ./src/docx/build_docx.py resources/cv.yaml
    ./src/html/build_html.py resources/cv.yaml

# ─── Type check ─────────────────────────────────────────────
typecheck:
    mypy src/

# ─── Validate (lint + check format + schema + types + tests) ─
validate: lint check-format validate-resume typecheck test
