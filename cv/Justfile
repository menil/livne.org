# ─── Lint ───────────────────────────────────────────────────
lint:
    ruff check .
    shellcheck ../.githooks/commit-msg
    bun run lint

# ─── Format ─────────────────────────────────────────────────
format:
    ruff format .
    shfmt -w ../.githooks/commit-msg .envrc
    bun run format

check-format:
    ruff format --check .
    shfmt -d ../.githooks/commit-msg .envrc
    bun run check-format

# ─── Test (unit + integration) ──────────────────────────────
test:
    python -m pytest tests/ -v --cov --cov-config=.coveragerc
    bun test

# ─── Resume schema validation ────────────────────────────────
validate-resume:
    python -m src.validate_resume resources/cv.yaml

# ─── Export YAML & JSON (PII resolved) ──────────────────────
export-yaml: validate-resume
    mkdir -p dist
    python -m src.export_yaml resources/cv.yaml dist/cv.yaml

export-json: validate-resume
    mkdir -p dist
    python -m src.export_json resources/cv.yaml dist/resume.json
    python -m src.export_json resources/cv.yaml dist/resume_public.json --public

# ─── Build Modular Targets ──────────────────────────────────
build-yaml: export-yaml

build-html: export-json
    mkdir -p dist
    bun run --bun resumed render dist/resume_public.json -o dist/$(python -m src.common dist/resume_public.json)_resume.html -t jsonresume-theme-signal

build-pdf: export-json
    mkdir -p dist
    bun run --bun resumed export dist/resume.json -o dist/$(python -m src.common dist/resume.json)_resume.pdf -t jsonresume-theme-signal --puppeteer-arg=--no-sandbox --puppeteer-arg=--disable-setuid-sandbox
    bun run --bun resumed export dist/resume_public.json -o dist/$(python -m src.common dist/resume_public.json)_resume_public.pdf -t jsonresume-theme-signal --puppeteer-arg=--no-sandbox --puppeteer-arg=--disable-setuid-sandbox

build-docx: export-json
    mkdir -p dist
    ./src/docx/build_docx.py dist/resume.json

build-md: export-json
    mkdir -p dist
    ./src/md/render_md.py dist/resume.json dist/cv.md

# ─── Build All Artifacts ────────────────────────────────────
build: export-yaml export-json build-html build-pdf build-docx build-md

# ─── Type check ─────────────────────────────────────────────
typecheck:
    mypy src/
    bun run typecheck

# ─── Validate (lint + check format + schema + types + tests) ─
validate: lint check-format validate-resume typecheck test
