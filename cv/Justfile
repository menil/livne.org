# ─── Lint ───────────────────────────────────────────────────
lint:
    ruff check .
    shellcheck ../.githooks/commit-msg

# ─── Format ─────────────────────────────────────────────────
format:
    ruff format .
    shfmt -w ../.githooks/commit-msg .envrc

check-format:
    ruff format --check .
    shfmt -d ../.githooks/commit-msg .envrc

# ─── Test (unit + integration) ──────────────────────────────
test:
    python -m pytest tests/ -v --cov --cov-config=.coveragerc

# ─── Build (PDF + DOCX) ─────────────────────────────────────
build:
    ./src/pdf/build_pdf.py resources/cv.md            # recruiter
    ./src/pdf/build_pdf.py resources/cv.md --public   # public
    ./src/docx/build_docx.py resources/cv.md
    ./src/html/build_html.py resources/cv.md

# ─── Type check ─────────────────────────────────────────────
typecheck:
    mypy src/

# ─── Validate (lint + check format + types + tests) ─────────
validate: lint check-format typecheck test
