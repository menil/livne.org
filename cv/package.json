{
  "name": "cv-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check-format": "biome format .",
    "build:html": "bun theme/index.ts",
    "build:pdf": "bun src/pdf/build_pdf.ts",
    "build:theme": "bun build theme/index.ts --outfile theme/index.js --target node --format esm --packages=bundle"
  },
  "trustedDependencies": ["@biomejs/biome"],
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.3.13",
    "@types/handlebars": "^4.1.0",
    "handlebars": "^4.7.8",
    "puppeteer": "^24.4.0",
    "resumed": "^7.0.0",
    "typescript": "^5.7.3"
  }
}
